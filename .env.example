# Hands-Off API — environment variables
# Copy this file to .env and fill in the values before deploying.
# Never commit .env to Git.

# ------------------------------------------------------------------
# Required in production (server.js will refuse to start without these)
# ------------------------------------------------------------------

# A strong random string used to sign bearer tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HANDSOFF_TOKEN_SECRET=

# The API key clients must send in the x-api-key header.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HANDSOFF_API_KEY=

# ------------------------------------------------------------------
# GitHub App integration (required for GitHub source scanning)
# ------------------------------------------------------------------

# Your GitHub App's numeric App ID (found on the App settings page).
GITHUB_APP_ID=

# The numeric Installation ID for the account/org where the App is installed.
GITHUB_APP_INSTALLATION_ID=

# The RSA private key generated for your GitHub App.
# Paste as a single line with literal \n between lines, e.g.:
#   GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
GITHUB_APP_PRIVATE_KEY=

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------

# Port to listen on (default: 3000)
PORT=3000

# Path to the SQLite scan database (default: .data/scans.db)
SCANS_STORE_PATH=

# Absolute path to the directory of local sample repositories (default: ./sample-repositories)
SAMPLE_REPOSITORIES_ROOT=

# Set to 'production' to enable startup env-var validation
NODE_ENV=production
